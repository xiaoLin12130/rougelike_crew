var _reg: Node = null
var _registered := {}  # kind -> Callable?????


func _ready() -> void:
	if not is_inside_tree():
		return
	_reg = get_node_or_null("/root/SynergyRegistry")
	if _reg == null:
		push_warning("[SynergyBase] SynergyRegistry ???????????")


func _exit_tree() -> void:
	_unregister_all()


## ???????kind ?? SynergyRegistry.trigger ?????cb ??? Callable?
func _register(kind: String, cb: Callable) -> void:
	if _reg == null or not _reg.has_method("register"):
		return
	_reg.register(kind, cb)
	_registered[kind] = cb


## ???????hooks ? [kind, Callable] ?????? _ready ???????????
func register_hooks(hooks: Array) -> void:
	for h in hooks:
		if h is Array and h.size() >= 2 and h[1] is Callable:
			_register(str(h[0]), h[1])


func _unregister_all() -> void:
	if _reg == null:
		return
	var hooks = _reg.get("_hooks")
	if hooks == null or not (hooks is Dictionary):
		return
	for kind in _registered:
		var arr = hooks.get(kind)
		if arr is Array:
			arr.erase(_registered[kind])
	_registered.clear()


func _enabled() -> bool:
	return is_inside_tree() and _reg != null


func _game_state() -> Node:
	return get_node_or_null("/root/GameState")


func _event_bus() -> Node:
	return get_node_or_null("/root/EventBus")


func _run_items() -> Dictionary:
	var gs := _game_state()
	if gs == null:
		return {}
	var run = gs.get("run")
	if run == null or not (run is Dictionary):
		return {}
	var items = run.get("items")
	if items == null or not (items is Dictionary):
		return {}
	return items


## ???????? GameState.total_stacks() ?????run.items ?? + ??????
## ??? 13 ?????? _stacks ???
func _stacks(item_id: String) -> int:
	var gs := _game_state()
	if gs == null:
		return 0
	var run: Variant = gs.get("run")
	if not (run is Dictionary):
		return 0
	var items: Variant = run.get("items", {})
	if not (items is Dictionary):
		return 0
	return maxi(int(items.get(item_id, 0)), 0)
