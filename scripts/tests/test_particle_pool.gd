## Run: godot --headless --path . res://scripts/tests/test_particle_pool.tscn

const FX_MANAGER_SCRIPT := preload("res://scripts/fx/fx_manager.gd")
const PARTICLE_POOL_MAX := 64

var _failures: Array[String] = []
var _fx: Node


func _ready() -> void:
	GameState.run.crit_chance = 0.0  # ???????????
	_fx = FX_MANAGER_SCRIPT.new()
	_fx.name = "FxManager"
	add_child(_fx)
	await get_tree().process_frame
	await _test_pool_bounds()
	await _test_reuse()
	await _test_no_leak()
	if _failures.is_empty():
		print("[TEST] PARTICLE POOL ALL PASS")
		get_tree().quit(0)
	else:
		for f in _failures:
			push_error("[TEST] FAIL: " + f)
		get_tree().quit(1)


func _fail(msg: String) -> void:
	_failures.append(msg)
	print("[TEST] FAIL: " + msg)


## ??? pool_key meta ???????????
func _live_pooled() -> int:
	var n := 0
	for c in _fx.get_children():
		if c is CPUParticles2D and c.has_meta("pool_key"):
			n += 1
	return n


func _stats() -> Dictionary:
	return _fx.call("particle_pool_stats")


func _burst(n: int) -> void:
	## ?????n ??? + 2n ??? + 2n ????fire ?? 3 ????
	for i in n:
		var pos := Vector2(200 + (i % 5) * 40, 150 + (i / 5) * 30)
		EventBus.fx_explosion.emit(pos, "fire")
		EventBus.fx_hit.emit(pos, "fire")
		EventBus.fx_cast.emit(pos, "fire", Vector2.RIGHT)


func _test_pool_bounds() -> void:
	## ? 100 ??? spawn?????????? 100?(???/?)????????
	var before: Dictionary = _stats()
	for round in 100:
		_burst(1)
		await get_tree().process_frame
	var after: Dictionary = _stats()
	var created_gain: int = after.created - before.created
	if created_gain <= 0:
		_fail("???????created ????")
	# ?????100 ? ? ??? 15 ??????flash 1 + layer ~9 + cast ~2 + hit ~2?
	# ????????????? 100 ????????????????"?????"
	var peak := _live_pooled()
	if peak > 100 * 20:
		_fail("????????????%d" % peak)
	print("[TEST] particle pool bounds: created=%d peak=%d" % [created_gain, peak])


func _test_reuse() -> void:
	## ? ?????????????????????????????
	var before: Dictionary = _stats()
	var round_created := 0
	for round in 8:
		_burst(5)
		await get_tree().create_timer(1.6).timeout  # fire smoke ?? 1.3s????
		var s: Dictionary = _stats()
		if round == 0:
			round_created = s.created - before.created
		elif s.created - before.created > round_created:
			_fail("? %d ?????????%d > %d??????" % [round, s.created - before.created, round_created])
	if _stats().reused - before.reused <= 0:
		_fail("????? > 0")
	if _live_pooled() != 0:
		_fail("?????????????????%d" % _live_pooled())
	print("[TEST] particle pool reuse OK (reused=%d)" % (_stats().reused - before.reused))


func _test_no_leak() -> void:
	## ? ?????????????????+?????
	var s: Dictionary = _stats()
	for key in s.idle:
		if int(s.idle[key]) > PARTICLE_POOL_MAX:
			_fail("? %s ?? %d ??? %d" % [key, s.idle[key], PARTICLE_POOL_MAX])
	# ???????? = created - ?????????? + ??? ? <= ????? + ????
	var total := _live_pooled()
	for key in s.idle:
		total += int(s.idle[key])
	if total > PARTICLE_POOL_MAX * 5 + 200:
		_fail("???????????%d" % total)
	print("[TEST] particle pool no-leak OK (total=%d)" % total)
