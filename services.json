{
    "services":  {
                     "static":  {
                                    "type":  "static",
                                    "cwd":  ".",
                                    "cmd":  [
                                                "python",
                                                "-m",
                                                "http.server",
                                                "{port}",
                                                "--bind",
                                                "127.0.0.1",
                                                "--directory",
                                                "export/web"
                                            ],
                                    "port":  8125,
                                    "purpose":  "static",
                                    "health":  {
                                                   "url":  "http://127.0.0.1:{port}",
                                                   "timeout":  15
                                               }
                                },
                     "tunnel":  {
                                    "origin":  "http://127.0.0.1:8125",
                                    "health":  {
                                                   "timeout":  30
                                               },
                                    "type":  "tunnel"
                                }
                 }
}
